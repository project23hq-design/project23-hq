# Project23 environment contract. Copy to apps/web/.env.local for local development.
# NEVER commit real secrets. Values below are placeholders.

# --- Application -------------------------------------------------------------
# development | test | staging | production. production refuses test payment/email adapters.
APP_ENV=development
# Public origin used for redirects, emails, canonical URLs and Paystack callback_url.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Local values are printed by `pnpm db:start` (or `pnpm exec supabase status -o env`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Public anon/publishable key: safe in the browser; all access is constrained by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Service role key BYPASSES RLS. Server-only (webhooks, jobs, guest checkout). Never expose.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- Payments ----------------------------------------------------------------
# test = deterministic local provider (no money moves, visibly labelled "Test payment").
# paystack = real Paystack API (use sk_test_… keys until live approval).
PAYMENT_PROVIDER=test
# Paystack secret key (sk_test_… or sk_live_…). Also used to verify x-paystack-signature.
PAYSTACK_SECRET_KEY=
# HMAC secret for the local test provider's simulated webhooks (>= 32 chars).
TEST_PROVIDER_SECRET=replace-with-32+-random-characters-xxxxxxxx

# --- Email -------------------------------------------------------------------
# capture = write emails to ./.mail-capture and view them at /dev/mail (non-production only).
# resend  = send through Resend (requires a verified sending domain).
EMAIL_PROVIDER=capture
RESEND_API_KEY=
EMAIL_FROM="Project23 <tickets@project23.example>"

# --- Secrets (generate each with: openssl rand -base64 48) --------------------
# Derives admission QR credentials. Rotating it invalidates every issued QR code.
TICKET_QR_SECRET=replace-with-48-random-bytes-base64-xxxxxxxxxxxxxxxx
# Signs first-party cookies (referral attribution, guest order access).
COOKIE_SIGNING_SECRET=replace-with-48-random-bytes-base64-xxxxxxxxxxxxxx
# Bearer token required by POST /api/jobs/tick (scheduler -> worker).
JOB_RUNNER_SECRET=replace-with-48-random-bytes-base64-xxxxxxxxxxxxxxxxx

LOG_LEVEL=info
