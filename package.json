{
  "name": "project23",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm --filter @project23/web dev",
    "build": "pnpm --filter @project23/web build",
    "start": "pnpm --filter @project23/web start",
    "worker": "pnpm --filter @project23/web worker",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:db": "supabase test db",
    "test:integration": "vitest run",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/database/src/types.gen.ts",
    "admin:create": "tsx scripts/create-super-admin.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "otplib": "13.5.0",
    "pg": "8.23.1",
    "@types/pg": "8.23.1",
    "vitest": "5.0.5",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["supabase", "esbuild", "sharp", "unrs-resolver"]
  }
}
